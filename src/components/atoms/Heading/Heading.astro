---
import { rangeOrder, type ResponsiveValues } from '../../../../config/breakpoints';
import { sanitizeHeading } from '../../../lib/sanitize-heading';

export type HeadingTag = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'span' | 'div';

export type HeadingSize = 'small' | 'normal' | 'large';

export interface Props {
	html: string;
	tag?: HeadingTag;
	size?: HeadingSize;
	responsiveSize?: ResponsiveValues<HeadingSize>;
	id?: string;
}

const { html, tag: Tag = 'h2', size = 'normal', responsiveSize = {}, id } = Astro.props;
const content = sanitizeHeading(html);
const responsiveClasses = rangeOrder.flatMap((range) => responsiveSize[range] ? [`heading--${range}-${responsiveSize[range]}`] : []);
---

<Tag class:list={['heading', `heading--${size}`, ...responsiveClasses]} id={id} set:html={content} />

<style lang="scss">
	@use './heading';
</style>
