---
import type { ImageMetadata } from 'astro';
import logoImage from '../../../assets/global/branding/wortise-logo.webp';
import { getLocaleFromPath, getHomePage, getPagePath } from '../../../i18n/routes';

export interface Props {
	src?: ImageMetadata;
	href?: string;
	alt?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const { src = logoImage, href = getPagePath(locale, getHomePage()), alt = 'Wortise' } = Astro.props;
---

<div class="logo">
	<a class="logo__link" href={href} aria-disabled={!href ? "true" : undefined} aria-label={alt}>
		<img class="logo__image" src={src.src} alt={alt} />
	</a>
</div>

<style lang="scss">
	@use './logo';
</style>
