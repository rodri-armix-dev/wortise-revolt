---
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import Button from '../../atoms/Button/Button.astro';
import { getLocaleFromPath, getHomePage, getPagePath } from '../../../i18n/routes';
export interface Props {
	image: ImageMetadata;
	tagline: { primary: string; secondary: string };
	contact: Omit<ComponentProps<typeof Button>, 'class'>;
}
const { image, tagline, contact } = Astro.props;
const homeHref = getPagePath(getLocaleFromPath(Astro.url.pathname), getHomePage());
---

<div class="footer-brand">
	<a class="footer-brand__link" href={homeHref} aria-disabled={!homeHref ? "true" : undefined}>
		<img class="footer-brand__image" src={image.src} width={image.width} height={image.height} alt="Wortise" loading="lazy" />
	</a>
	<p class="footer-brand__tagline">
		{tagline.primary}<br />
		<span class="footer-brand__secondary">{tagline.secondary}</span>
	</p>
	<Button {...contact} />
</div>

<style lang="scss">
	@use './footer-brand';
</style>
