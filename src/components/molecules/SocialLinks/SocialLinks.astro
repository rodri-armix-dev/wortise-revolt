---
import type { ImageMetadata } from 'astro';
export interface Props { title: string; items: { label: string; href: string; icon: ImageMetadata }[]; }
const { title, items } = Astro.props;
---

<nav class="social-links" aria-label={title}>
	<h2 class="social-links__title">{title}</h2>
	<ul class="social-links__list" role="list">
		{items.map((item) =>
			<li class="social-links__item">
				<a class="social-links__link" href={item.href} aria-label={item.label}>
					<span class="social-links__icon" aria-hidden="true" style={{ '--social-links-icon-image': `url("${item.icon.src}")`, '--social-links-icon-width': `${item.icon.width}px`, '--social-links-icon-height': `${item.icon.height}px` }} />
				</a>
			</li>
		)}
	</ul>
</nav>

<style lang="scss">
	@use './social-links';
</style>
