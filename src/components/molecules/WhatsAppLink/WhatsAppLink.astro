---
import whatsappIcon from '../../../assets/global/icons/whatsapp.svg?url';

export interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="whatsapp-link" href={href} target="_blank" rel="noopener" aria-label={label}>
	<img src={whatsappIcon} alt="" width="56" height="56" />
</a>

<style lang="scss">
	@use './whatsapp-link';
</style>
