---
import TextBlock from '../../molecules/TextBlock/TextBlock.astro';
import adsLogo from '../../../assets/pages/wortise-ads/wortise-ads-logo-transparent.png';
import type { ComponentProps } from 'astro/types';

export interface Props {
	textBlock: ComponentProps<typeof TextBlock>;
}

const { textBlock } = Astro.props;
---

<section class="ads-cover">
	<div class="ads-cover__inner global-inner">
		<div class="ads-cover__text-block">
			<div class="ads-cover__logo" role="img" aria-label="Wortise Ads" style={{ backgroundImage: `url(${adsLogo.src})` }}></div>
			<TextBlock {...textBlock} heading={textBlock.heading && { ...textBlock.heading, size: { s: 'display-sm', l: 'display-xl' } }} />
		</div>
	</div>
</section>

<style lang="scss">
	@use './ads-cover';
</style>
