---
import type { ComponentProps } from 'astro/types';
import TextBlock from '../../molecules/TextBlock/TextBlock.astro';

export interface Props {
	textBlock: ComponentProps<typeof TextBlock>;
}

const { textBlock } = Astro.props;
---

<section class="developers-cover">
	<div class="developers-cover__inner global-inner">
		<div class="developers-cover__text-block">
			<TextBlock {...textBlock} />
		</div>
	</div>
</section>

<style lang="scss">
	@use './developers-cover';
</style>
