---
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import Logo from '../../atoms/Logo/Logo.astro';
import { getDestinationHref } from '../../../data/destinations';
import { getLocaleFromPath, isPage } from '../../../i18n/routes';
import TextBlock from '../../molecules/TextBlock/TextBlock.astro';
export interface Props { logo: ComponentProps<typeof Logo>; text: ComponentProps<typeof TextBlock>; background: ImageMetadata; actionPage?: string; }
const { logo, text, background, actionPage } = Astro.props;
const href = actionPage && isPage(actionPage) ? getDestinationHref(getLocaleFromPath(Astro.url.pathname), actionPage) : undefined;
const resolvedText = actionPage && text.actions?.primary ? { ...text, actions: { ...text.actions, primary: { ...text.actions.primary, href: href ?? '', disabled: !href } } } : text;
const headingId = text.heading?.html.trim() ? text.heading.id ?? 'footer-cta-heading' : undefined;
---

<section class="footer-cta" style={{ '--footer-cta-background': `url("${background.src}")` }} aria-labelledby={headingId}>
	<div class="footer-cta__inner global-inner">
		<div class="footer-cta__logo">
			<Logo {...logo} />
		</div>
		<div class="footer-cta__text-block">
			<TextBlock {...resolvedText} heading={text.heading && { ...text.heading, id: headingId, size: { s: 'display-sm', xl: 'display-xl' } }} alignment="center" />
		</div>
	</div>
</section>

<style lang="scss">
	@use './footer-cta';
</style>
