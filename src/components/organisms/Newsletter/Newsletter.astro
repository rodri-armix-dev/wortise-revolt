---
import type { Locale } from '../../../i18n/config';
import { getUiText } from '../../../i18n/ui';
import TextBlock from '../../molecules/TextBlock/TextBlock.astro';
import Button from '../../atoms/Button/Button.astro';
import Logo from '../../atoms/Logo/Logo.astro';
import { footerCTAVisuals } from '../../../data/footer-cta';

export interface Props {
	locale: Locale;
	title: string;
	description: string;
}
const { locale, title, description } = Astro.props;
const ui = getUiText(locale);
---

<newsletter-form class="newsletter" style={{ '--newsletter-background': `url("${footerCTAVisuals.background.src}")` }} data-unavailable-label={ui.blogNewsletterUnavailable}>
	<section class="newsletter__inner global-inner" aria-labelledby="newsletter-heading">
		<div class="newsletter__logo">
			<Logo {...footerCTAVisuals.logo} />
		</div>
		<div class="newsletter__text-block">
			<TextBlock alignment="center" heading={{ html: title, id: 'newsletter-heading' }} description={{ html: description }} />
		</div>
		<form class="newsletter__form" method="dialog">
			<fieldset class="newsletter__fields" disabled>
				<input class="newsletter__input" id="newsletter-email" name="email" type="email" aria-label={ui.blogEmailLabel} placeholder={ui.blogEmailPlaceholder} autocomplete="email" required />
				<div class="newsletter__action">
					<Button label={ui.blogSubscribe} variant="primary-special" size="large" type="submit" />
				</div>
			</fieldset>
		</form>
		<p class="newsletter__status" role="status" data-newsletter-status></p>
	</section>
</newsletter-form>

<script>
	import './newsletter';
</script>

<style lang="scss">
	@use './newsletter';
</style>
