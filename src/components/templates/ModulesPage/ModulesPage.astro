---
import type { Locale } from '../../../i18n/config';
import type AboutTimeline from '../../organisms/AboutTimeline/AboutTimeline.astro';
import type AboutHistory from '../../organisms/AboutHistory/AboutHistory.astro';
import type ContactSection from '../../organisms/ContactSection/ContactSection.astro';
import type LogoMarquee from '../../molecules/LogoMarquee/LogoMarquee.astro';
import type Hero from '../../organisms/Hero/Hero.astro';
import type AdsCover from '../../organisms/AdsCover/AdsCover.astro';
import type AdvertisersClients from '../../organisms/AdvertisersClients/AdvertisersClients.astro';
import type AdvertisersCover from '../../organisms/AdvertisersCover/AdvertisersCover.astro';
import type DevelopersCover from '../../organisms/DevelopersCover/DevelopersCover.astro';
import type Certifications from '../../organisms/Certifications/Certifications.astro';
import type AdMonetNetworks from '../../organisms/AdMonetNetworks/AdMonetNetworks.astro';
import type AdsSections from '../../organisms/AdsSections/AdsSections.astro';
import type AboutUsCover from '../../organisms/AboutUsCover/AboutUsCover.astro';
import type AudienceSections from '../../organisms/AudienceSections/AudienceSections.astro';
import type WorldSolutions from '../../organisms/WorldSolutions/WorldSolutions.astro';
import type Kpis from '../../organisms/Kpis/Kpis.astro';
import type VideoSection from '../../organisms/VideoSection/VideoSection.astro';
import type ImageGallery from '../../organisms/ImageGallery/ImageGallery.astro';
import type PublisherDashboard from '../../organisms/PublisherDashboard/PublisherDashboard.astro';
import type FaqSection from '../../organisms/FaqSection/FaqSection.astro';
import type ProcessTimeline from '../../organisms/ProcessTimeline/ProcessTimeline.astro';
import type RecruitingSection from '../../organisms/RecruitingSection/RecruitingSection.astro';
import type { ComponentProps } from 'astro/types';

export interface ModulePropsByType {
	'contact-section': ComponentProps<typeof ContactSection>;
	hero: ComponentProps<typeof Hero>;
	'ads-cover': ComponentProps<typeof AdsCover>;
	'advertisers-clients': ComponentProps<typeof AdvertisersClients>;
	'advertisers-cover': ComponentProps<typeof AdvertisersCover>;
	'developers-cover': ComponentProps<typeof DevelopersCover>;
	certifications: ComponentProps<typeof Certifications>;
	'admonet-networks': ComponentProps<typeof AdMonetNetworks>;
	'ads-sections': ComponentProps<typeof AdsSections>;
	'logo-marquee': ComponentProps<typeof LogoMarquee>;
	'about-timeline': ComponentProps<typeof AboutTimeline>;
	'about-history': ComponentProps<typeof AboutHistory>;
	'about-us-cover': ComponentProps<typeof AboutUsCover>;
	'audience-sections': ComponentProps<typeof AudienceSections>;
	'world-solutions': ComponentProps<typeof WorldSolutions>;
	kpis: ComponentProps<typeof Kpis>;
	'video-section': ComponentProps<typeof VideoSection>;
	'image-gallery': ComponentProps<typeof ImageGallery>;
	'publisher-dashboard': ComponentProps<typeof PublisherDashboard>;
	'faq-section': ComponentProps<typeof FaqSection>;
	'process-timeline': ComponentProps<typeof ProcessTimeline>;
	'recruiting-section': ComponentProps<typeof RecruitingSection>;
}

export type PageModule = {
	[Type in keyof ModulePropsByType]: {
		type: Type;
		props: ModulePropsByType[Type];
	};
}[keyof ModulePropsByType];

export interface Props {
	modules: PageModule[];
	locale: Locale;
}

const { modules, locale } = Astro.props;
---

<div class="modules-page">
	{modules.map(async (module) => {
		if (module.type === 'contact-section') {
			const { default: ContactSection } = await import('../../organisms/ContactSection/ContactSection.astro');
			return <ContactSection {...module.props} />;
		}

		if (module.type === 'hero') {
			const { default: Hero } = await import('../../organisms/Hero/Hero.astro');
			return <Hero {...module.props} />;
		}

		if (module.type === 'ads-cover') {
			const { default: AdsCover } = await import('../../organisms/AdsCover/AdsCover.astro');
			return <AdsCover {...module.props} />;
		}

		if (module.type === 'ads-sections') {
			const { default: AdsSections } = await import('../../organisms/AdsSections/AdsSections.astro');
			return <AdsSections {...module.props} />;
		}

		if (module.type === 'advertisers-clients') {
			const { default: AdvertisersClients } = await import('../../organisms/AdvertisersClients/AdvertisersClients.astro');
			return <AdvertisersClients {...module.props} />;
		}

		if (module.type === 'advertisers-cover') {
			const { default: AdvertisersCover } = await import('../../organisms/AdvertisersCover/AdvertisersCover.astro');
			return <AdvertisersCover {...module.props} />;
		}

		if (module.type === 'developers-cover') {
			const { default: DevelopersCover } = await import('../../organisms/DevelopersCover/DevelopersCover.astro');
			return <DevelopersCover {...module.props} />;
		}

		if (module.type === 'certifications') {
			const { default: Certifications } = await import('../../organisms/Certifications/Certifications.astro');
			return <Certifications {...module.props} />;
		}

		if (module.type === 'admonet-networks') {
			const { default: AdMonetNetworksDemo } = await import('../../organisms/AdMonetNetworksDemo/AdMonetNetworksDemo.astro');
			return <AdMonetNetworksDemo {...module.props} />;
		}

		if (module.type === 'logo-marquee') {
			const { default: LogoMarquee } = await import('../../molecules/LogoMarquee/LogoMarquee.astro');
			return <LogoMarquee {...module.props} />;
		}

		if (module.type === 'audience-sections') {
			const { default: HomeScrollDriven } = await import('../../organisms/HomeScrollDriven/HomeScrollDriven.astro');
			return <HomeScrollDriven {...module.props} locale={locale} />;
		}

		if (module.type === 'world-solutions') {
			const { default: WorldSolutions } = await import('../../organisms/WorldSolutions/WorldSolutions.astro');
			return <WorldSolutions {...module.props} />;
		}

		if (module.type === 'kpis') {
			const { default: Kpis } = await import('../../organisms/Kpis/Kpis.astro');
			return <Kpis {...module.props} />;
		}

		if (module.type === 'video-section') {
			const { default: VideoSection } = await import('../../organisms/VideoSection/VideoSection.astro');
			return <VideoSection {...module.props} />;
		}

		if (module.type === 'image-gallery') {
			const { default: ImageGallery } = await import('../../organisms/ImageGallery/ImageGallery.astro');
			return <ImageGallery {...module.props} />;
		}

		if (module.type === 'publisher-dashboard') {
			const { default: PublisherDashboard } = await import('../../organisms/PublisherDashboard/PublisherDashboard.astro');
			return <PublisherDashboard {...module.props} />;
		}

		if (module.type === 'faq-section') {
			const { default: FaqSection } = await import('../../organisms/FaqSection/FaqSection.astro');
			return <FaqSection {...module.props} />;
		}

		if (module.type === 'process-timeline') {
			const { default: ProcessTimeline } = await import('../../organisms/ProcessTimeline/ProcessTimeline.astro');
			return <ProcessTimeline {...module.props} />;
		}

		if (module.type === 'recruiting-section') {
			const { default: RecruitingSection } = await import('../../organisms/RecruitingSection/RecruitingSection.astro');
			return <RecruitingSection {...module.props} />;
		}

		if (module.type === 'about-timeline') {
			const { default: AboutTimeline } = await import('../../organisms/AboutTimeline/AboutTimeline.astro');
			return <AboutTimeline {...module.props} />;
		}

		if (module.type === 'about-history') {
			const { default: AboutHistory } = await import('../../organisms/AboutHistory/AboutHistory.astro');
			return <AboutHistory {...module.props} />;
		}

		const { default: AboutUsCover } = await import('../../organisms/AboutUsCover/AboutUsCover.astro');
		return <AboutUsCover {...module.props} />;
	})}
</div>

<style lang="scss">
	@use './modules-page';
</style>
