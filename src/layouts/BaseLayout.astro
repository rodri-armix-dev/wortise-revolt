---
import type { ComponentProps } from 'astro/types';
import WhatsAppLink from '../components/molecules/WhatsAppLink/WhatsAppLink.astro';
import type CTA from '../components/organisms/CTA/CTA.astro';
import { getSiteData } from '../data/site';
import Footer from '../components/organisms/Footer/Footer.astro';
import Header from '../components/organisms/Header/Header.astro';
import type { Locale } from '../i18n/config';
import '../styles/global.scss';

export interface Props {
	locale: Locale;
	footerCTA?: ComponentProps<typeof CTA>;
	title: string;
	description?: string;
	headerOverlay?: boolean;
}

const { locale, title, description, footerCTA, headerOverlay = false } = Astro.props;
const site = getSiteData(locale, Astro.url.pathname);
const assetBase = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const CTAComponent = site.includeFooterCTA && footerCTA ? (await import('../components/organisms/CTA/CTA.astro')).default : undefined;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		{description && (
			<meta name="description" content={description} />
		)}
		<title>{title}</title>
		<link rel="icon" type="image/x-icon" href={`${assetBase}favicon.ico`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${assetBase}favicon-32x32.png`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${assetBase}favicon-16x16.png`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${assetBase}apple-touch-icon.png`} />
		<link rel="manifest" href={`${assetBase}site.webmanifest`} />
		<script>
			import '../i18n/preference';
		</script>
	</head>
	<body class="base-layout">
		<Header {...site.header} />
		<main class:list={['base-layout__main', { 'base-layout__main--header-overlay': headerOverlay }]} id="main-content">
			<slot />
		</main>
		{CTAComponent && footerCTA && (
			<CTAComponent {...footerCTA} />
		)}
		<Footer locale={locale} {...site.footer} />
		{site.whatsapp && (
			<WhatsAppLink {...site.whatsapp} />
		)}
	</body>
</html>

<style lang="scss">
	@use './base-layout';
</style>
