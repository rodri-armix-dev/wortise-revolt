---
import ModulesPage from '../../components/templates/ModulesPage/ModulesPage.astro';
import LegalPage from '../../components/templates/LegalPage/LegalPage.astro';
import { getPublishedPages } from '../../i18n/routes';
import type { Locale } from '../../i18n/config';
import type { EditorialPageData } from '../../data/pages/page.types';
import BaseLayout from '../../layouts/BaseLayout.astro';

export interface Props {
	locale: Locale;
	page: EditorialPageData;
}

export function getStaticPaths() {
	return getPublishedPages().filter(({ page }) => page.slug === '').map(({ locale, page }) => ({
		params: { locale },
		props: { locale, page } satisfies Props,
	}));
}

const { locale, page } = Astro.props;
const BlogIndex = page.template === 'blog' ? (await import('../../components/templates/BlogIndex/BlogIndex.astro')).default : undefined;
const BlogArticle = page.template === 'blog-article' ? (await import('../../components/templates/BlogArticle/BlogArticle.astro')).default : undefined;
const GlossaryIndex = page.template === 'glossary' ? (await import('../../components/templates/GlossaryIndex/GlossaryIndex.astro')).default : undefined;
---

<BaseLayout locale={locale} title={page.meta.title} description={page.meta.description} footerCTA={'footerCTA' in page ? page.footerCTA : undefined} headerOverlay={'modules' in page && ['ads-cover', 'advertisers-cover'].includes(page.modules[0]?.type ?? '')}>
	{page.template === 'legal' ? (
		<LegalPage locale={locale} {...page.content} />
	) : page.template === 'blog' && BlogIndex ? (
		<BlogIndex locale={locale} />
	) : page.template === 'blog-article' && BlogArticle ? (
		<BlogArticle locale={locale} post={page.content} />
	) : page.template === 'glossary' && GlossaryIndex ? (
		<GlossaryIndex content={page.content} />
	) : (
		'modules' in page && <ModulesPage modules={page.modules} locale={locale} />
	)}
</BaseLayout>
